# Kernel configuration: CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script.
# y and n are 1 and 0, a quoted string or a number is passed through, {tree} is the build tree.
# Stage 1 (bring-up): ARM64 + platform + software crypto only.
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_NATIVE_UFS is not set        (needs NativeUfs8996 component)
# CONFIG_XNU_NATIVE_ADRENO is not set     (needs Adreno530 component)
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set (needs GopFramebuffer + firmware FB)
# Secondary CPU bring-up: enable after the GIC 3-cell specifier check passes.
# CONFIG_XNU_ARMCPU_SECONDARY is not set
# g0245d v321 (2026-11-24): Stage 2 storage.  BUILD_ARCHIVES lets
# scripts/unixnu/kernel.py run the [kernel].archives recipes, and
# EXTRA_LD_ARCHIVES force-loads the resulting IOKit driver so its
# NativeUfs8996 class is registered before IOKit matches personalities.
# Do NOT set CONFIG_XNU_NATIVE_UFS: build-xnu-4k-baseline.sh hardcodes
# UFS_ARCHIVE=$ROOT/build/sheng-ufs/libShengUfs.a for that switch (the SM8550
# component), and its `test -f` would fail here.
# g0245d v323 (2026-11-24): bisect step. Turn archive building and the UFS
# force_load OFF so this build carries no native-driver code at all; it is the
# closest possible configuration to the working v320 image.
CONFIG_XNU_BUILD_ARCHIVES=y
# g0245d v385 (2026-11-27, 公司机接续): re-enable the UFS driver force-load.
# v323 had turned it off for the bisect, and v385's bsd_init probe refers to
# ufs8996_ver / ufs8996_uic_* directly, so without this the kernel link fails
# with "symbol(s) not found" for every one of them.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/native-ufs-8996/libNativeUfs8996.a"
# Empty string, NOT "is not set": the boolean parser turns False into the
# literal "0" and the linker then receives a bare "0" as an input file.
# g0245d v289/v290: mockfs memory root (offline executable-root fixture).
# Requires XNU_ARMCPU=y + XNU_SOURCE_PTHREAD=y (both set above).
# Drives archive-07-build-mockfs-fixture.py -> libmockfs_fixture.a
# (-Wl,-force_load into the kernel) and -DMOCKFS=1 on vfs_conf.o.
# The device defconfig applies LAST, overriding os:configs/ios.config's
# "# CONFIG_XNU_SOURCE_MOCKFS is not set".  Verify the generated work/.config
# ends with CONFIG_XNU_SOURCE_MOCKFS=y after "unixnu defconfig".
CONFIG_XNU_SOURCE_MOCKFS=y

# g0245d v321 (2026-11-24): SoftwareAES derives from IOKit's IOAESAccelerator,
# which only exists in the real iOS prelinked kext closure; rebuilding the
# archive here resolves the vtable to undefined symbols and the kernel link
# fails.  The arch fragment turns it on by default, so override it last.  AES
# comes from CONFIG_XNU_SOURCE_CORECRYPTO14 (prelinked bootstrap) instead.
# CONFIG_XNU_NATIVE_AES is not set

# G0245D Stage 5: official boot-progress diagnostic page (boot-progress=2)
CONFIG_XNU_BOOT_PROGRESS=y
