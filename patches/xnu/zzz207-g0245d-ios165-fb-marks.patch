--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -91,6 +91,41 @@
 .endmacro
 
 /*
+ * g0245d iOS early-boot marks: colored bands painted into the firmware
+ * framebuffer while the MMU is still off. Panel byte order is (G, R, B).
+ * Each band is 8 rows tall at raw row \row, full 1080-px width.
+ *   1300 magenta = kernel entry reached (start_first_cpu)
+ *   1320 yellow  = common_start (bootstrap page tables built)
+ *   1340 cyan    = TCR programmed
+ *   1360 green   = TTBR0/TTBR1 programmed
+ *   1380 blue    = MAIR programmed; next step enables the MMU and the
+ *                  panel is no longer reachable, so there are no further
+ *                  marks. Missing bands localize the death point.
+ * Clobbers x9-x16 (dead at every call site).
+ */
+.macro FB_MARK207 argsreg, row, gval, rval, bval
+	ldr	x9, [\argsreg, #0x28]			// Video.v_baseAddr (fb PA)
+	cbz	x9, 9f
+	ldr	x10, [\argsreg, #0x38]			// Video.v_rowBytes
+	cbz	x10, 9f
+	mov	x11, #\row
+	madd	x9, x11, x10, x9			// fb + row * rowBytes
+	mov	w12, #\gval
+	mov	w13, #\rval
+	mov	w14, #\bval
+	mov	x15, #8					// 8 rows
+1:	mov	x16, #1080				// pixels per row
+2:	strb	w12, [x9], #1				// G
+	strb	w13, [x9], #1				// R
+	strb	w14, [x9], #1				// B
+	subs	x16, x16, #1
+	b.ne	2b
+	subs	x15, x15, #1
+	b.ne	1b
+9:
+.endm
+
+/*
  * Checks the reset handler for global and CPU-specific reset-assist functions,
  * then jumps to the reset handler with boot args and cpu data. This is copied
  * to the first physical page during CPU bootstrap (see cpu.c).
@@ -462,6 +497,9 @@
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+	// g0245d v207: mark 0 (magenta) - kernel entry point reached, MMU off.
+	FB_MARK207 x0, 1300, 0x00, 0xFF, 0xFF
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -645,6 +683,9 @@
  */
 common_start:
 
+	// g0245d v207: mark 1 (yellow) - bootstrap page tables built, MMU off.
+	FB_MARK207 x20, 1320, 0xFF, 0xFF, 0x00
+
 #if HAS_NEX_PG
 	mov x19, lr
 	bl		EXT(set_nex_pg)
@@ -657,6 +698,9 @@
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
 	MSR_TCR_EL1_X1
 
+	// g0245d v207: mark 2 (cyan) - TCR programmed, MMU off.
+	FB_MARK207 x20, 1340, 0xFF, 0x00, 0xFF
+
 	/* Set up translation table base registers.
 	 *	TTBR0 - V=P table @ top of kernel
 	 *	TTBR1 - KVA table @ top of kernel + 1 page
@@ -674,6 +718,9 @@
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
+	// g0245d v207: mark 3 (green) - TTBR0/TTBR1 programmed, MMU off.
+	FB_MARK207 x20, 1360, 0xFF, 0x00, 0x00
+
 	// Set up MAIR attr0 for normal memory, attr1 for device memory
 	mov		x0, xzr
 	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
@@ -753,6 +800,9 @@
 #endif /* HAS_APPLE_PAC */
 
 	// Enable caches, MMU, ROP and JOP
+	// g0245d v207: mark 4 (blue) - last mark before MMU enable.
+	FB_MARK207 x20, 1380, 0x00, 0x00, 0xFF
+
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
