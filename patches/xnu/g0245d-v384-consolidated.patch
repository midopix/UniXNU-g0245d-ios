+	if (source_pthread_status != KERN_SUCCESS) {
+		panic("source libpthread registration failed: %d", source_pthread_status);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, source_pthread_bootstrap);
