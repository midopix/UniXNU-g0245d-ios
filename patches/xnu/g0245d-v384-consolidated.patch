+	unsigned char   g,
+	unsigned char   r,
+	unsigned char   b)
+{
+	g0245d_con_printf("%u pexpert row=%u\n", g0245d_con_seq, row);
+	g0245d_fb_band(BootArgs, row, g, r, b);
+}
