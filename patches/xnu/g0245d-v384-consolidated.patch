+#elif defined(G0245D_GICV2)
+/* g0245d v283: GIC-400 (GICv2, MMIO).  Per-PE state lives in the GICC
+ * view (banked); shared state in GICD.  TrustZone owns Group 0 on this
+ * platform, so all our interrupts are Group 1 NS and surface as IRQs
+ * handled by sleh_irq(). */
+vm_offset_t g0245d_gicd_base;
+vm_offset_t g0245d_gicc_base;
+
+/* g0245d v285: stashed diagnostics for the console-visible dump at the
+ * freeze point (pe_init_fiq runs before the framebuffer console, so the
+ * on-boot prints scroll away before any photo can catch them). */
+unsigned int g0245d_rb_gicd_ctlr;
+unsigned int g0245d_rb_gicd_igrp0;
+unsigned int g0245d_rb_gicc_ctlr;
+unsigned int g0245d_rb_cntfrq;
+
+void
+pe_init_fiq()
+{
+	if (!g0245d_gicd_base) {
+		g0245d_gicd_base = ml_io_map(G0245D_GICD_BASE, G0245D_GICD_SIZE);
+		g0245d_gicc_base = ml_io_map(G0245D_GICC_BASE, G0245D_GICC_SIZE);
+		kprintf("G0245D GICv2: gicd@%08x gicc@%08x\n",
+		    (unsigned int)G0245D_GICD_BASE,
+		    (unsigned int)G0245D_GICC_BASE);
+	}
+
+	/* GICC: this PE's view */
+	{
+		volatile unsigned int *gicc =
+		    (volatile unsigned int *)g0245d_gicc_base;
+		gicc[0x04 / 4] = 0xFF;  /* PMR: pass all priorities */
+		gicc[0x1C / 4] = 0;     /* BPR1 */
+		gicc[0x00 / 4] = 0x3;   /* CTLR: enable + signal Group 1 as IRQ */
+	}
+
+	/* GICD: shared */
+	{
+		volatile unsigned int *gicd =
+		    (volatile unsigned int *)g0245d_gicd_base;
+		int i;
+		/* IGROUPR0..7: SGI+PPI+SPI all Group 1 (TZ owns Group 0) */
+		for (i = 0; i < 8; i++) {
+			gicd[0x080 / 4 + i] = 0xFFFFFFFFu;
+		}
+		gicd[0x400 / 4] = 0xA0A0A0A0u;       /* IPRIORITYR0: SGI 1 */
+		gicd[0x400 / 4 + 6] = 0xA0A0A0A0u;   /* IPRIORITYR6: INTID 27 */
+		gicd[0x100 / 4] = (1u << G0245D_VTIMER_INTID) |
+		    (1u << G0245D_IPI_SGI);          /* ISENABLER0 */
+		gicd[0x000 / 4] |= 0x3u;             /* CTLR: enable grp0+grp1 */
+	}
+
+	/* g0245d v284: read back what we wrote.  TrustZone silently eating
+	 * NS writes shows up as zero here. */
+	{
+		extern void g0245d_trace_u(const char *, unsigned int);
+		volatile unsigned int *gicd =
+		    (volatile unsigned int *)g0245d_gicd_base;
+		volatile unsigned int *gicc =
+		    (volatile unsigned int *)g0245d_gicc_base;
+		g0245d_rb_gicd_ctlr = gicd[0x000 / 4];
+		g0245d_rb_gicd_igrp0 = gicd[0x080 / 4];
+		g0245d_rb_gicc_ctlr = gicc[0x000 / 4];
+		g0245d_trace_u("v284 gicd ctlr", g0245d_rb_gicd_ctlr);
+		g0245d_trace_u("v284 gicd igrp0", g0245d_rb_gicd_igrp0);
+		g0245d_trace_u("v284 gicc ctlr", g0245d_rb_gicc_ctlr);
+	}
+
+	/* g0245d v284: self-test -- arm the virtual timer ~250 ms out and
+	 * enable CNTV (in case _enable_virtual_timer has not run yet).
+	 * If the GIC delivers, sleh_irq logs "v284 irq <intid>". */
+	{
+		extern void g0245d_trace_u(const char *, unsigned int);
+		uint64_t frq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		uint64_t now = __builtin_arm_rsr64("CNTVCT_EL0");
+		__builtin_arm_wsr64("CNTV_CVAL_EL0", now + frq / 4);
+		__builtin_arm_wsr64("CNTV_CTL_EL0", 1);	/* enable, unmasked */
+		g0245d_rb_cntfrq = (unsigned int)frq;
+		g0245d_trace_u("v284 cval armed", g0245d_rb_cntfrq);
+	}
 }
 #else
 void
