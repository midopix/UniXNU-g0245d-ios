+/*
+ * g0245d v210: post-return C-side boot marks.
+ *
+ * v209 stops at the last band painted just before start.s returns. The bands
+ * below are painted from inside arm_init, so one can only appear if control
+ * really landed in C instead of dying somewhere after that `ret`.
+ *
+ * Every mark here sits before arm_vm_init(). Until it runs, TTBR0 still holds
+ * the bootstrap V=P table whose 0x83400000 window v209 added, so a store by
+ * physical address stays valid. arm_vm_init installs the kernel pmap, after
+ * which the same store is undefined -- hence nothing is painted past it.
+ *
+ * ARM_TTE_BOOT_BLOCK maps that window write-back cacheable, so the band has to
+ * be cleaned to the point of coherency; the panel reads DRAM, and a dirty line
+ * would leave the band invisible.
+ *
+ * Byte order is (G, R, B) and the panel shows raw row R at 1919 - R, exactly
+ * like FB_MARK207 in start.s.
+ */
+#define G0245D_FB_BAND_ROWS     8
+#define G0245D_FB_BAND_WIDTH    1080
+
+extern boolean_t g0245d_kva_live;
+extern vm_offset_t g0245d_fb_kva(vm_offset_t pa);
+
+static void __attribute__((noinline))
+g0245d_fb_band(
+	boot_args       *args,
+	unsigned int    row,
+	unsigned char   g,
+	unsigned char   r,
+	unsigned char   b)
+{
+	uintptr_t       fb = (uintptr_t)args->Video.v_baseAddr;
+	unsigned long   rowbytes = args->Video.v_rowBytes;
+	uintptr_t       start;
+	uintptr_t       end;
+	uintptr_t       p;
+	unsigned int    y;
+	unsigned int    x;
+
+	if (fb == 0 || rowbytes == 0) {
+		return;
+	}
+
+	/* g0245d v221: past the TTBR switch the raw physical value is no longer a
+	 * valid VA; translate it through the physmap instead of faulting. */
+	if (g0245d_kva_live) {
+		fb = (uintptr_t)g0245d_fb_kva((vm_offset_t)fb);
+		if (fb == 0) {
+			return;
+		}
+	}
+
+	start = fb + (uintptr_t)row * (uintptr_t)rowbytes;
+	end = start + (uintptr_t)G0245D_FB_BAND_ROWS * (uintptr_t)rowbytes;
+
+	for (y = 0; y < G0245D_FB_BAND_ROWS; y++) {
+		p = start + (uintptr_t)y * (uintptr_t)rowbytes;
+		for (x = 0; x < G0245D_FB_BAND_WIDTH; x++) {
+			*(volatile unsigned char *)(p + 0) = g;
+			*(volatile unsigned char *)(p + 1) = r;
+			*(volatile unsigned char *)(p + 2) = b;
+			p += 3;
+		}
+	}
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (p = start; p < end; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * g0245d v215: wipe the whole framebuffer before painting this boot's marks.
+ *
+ * The DarwinBoot menu, the Apple logo, the version banner and the boot
+ * progress bar all occupy the same rows as our checkpoints, and once the
+ * camera has smeared them they are indistinguishable from a dim band. Clear
+ * first, and every colour left on the panel then comes from a
+ * g0245d_fb_band() call made by this boot -- the photo becomes a plain
+ * ordered ladder of lines on black.
+ *
+ * start.s only identity-maps the first 8 MiB above the framebuffer in the
+ * bootstrap V=P table (four 2 MiB blocks at 0x83400000), so the wipe is
+ * clamped to that window instead of trusting v_height.
+ */
+#define G0245D_FB_WINDOW_BYTES	(8ULL * 1024ULL * 1024ULL)
+#define G0245D_FB_WIPE_MAX_ROWS	1920ULL	/* panel is exactly 1920 lines */
+
+static void __attribute__((noinline))
+g0245d_fb_wipe(
+	boot_args       *args)
+{
+	uintptr_t       fb = (uintptr_t)args->Video.v_baseAddr;
+	unsigned long   rowbytes = args->Video.v_rowBytes;
+	unsigned long   rows;
+	unsigned long   y;
+	uintptr_t       p;
+	uintptr_t       e;
+
+	if (fb == 0 || rowbytes == 0) {
+		return;
+	}
+	if ((uint64_t)rowbytes > G0245D_FB_WINDOW_BYTES) {
+		return;
+	}
+
+	rows = (unsigned long)(G0245D_FB_WINDOW_BYTES / (uint64_t)rowbytes);
+	if (rows > G0245D_FB_WIPE_MAX_ROWS) {
+		rows = (unsigned long)G0245D_FB_WIPE_MAX_ROWS;
+	}
+
+	for (y = 0; y < rows; y++) {
+		p = fb + (uintptr_t)y * (uintptr_t)rowbytes;
+		e = p + (uintptr_t)rowbytes;
+		if (((p | (uintptr_t)rowbytes) & 7) == 0) {
+			for (; p < e; p += 8) {
+				*(volatile uint64_t *)p = 0;
+			}
+		} else {
+			for (; p < e; p++) {
+				*(volatile unsigned char *)p = 0;
+			}
+		}
+	}
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	p = fb;
+	e = fb + (uintptr_t)rows * (uintptr_t)rowbytes;
+	for (; p < e; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
