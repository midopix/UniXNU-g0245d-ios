+++ b/osfmk/arm64/arm_vm_init.c
@@ -363,6 +363,32 @@ typedef struct {
 
 #define PTOV_TABLE_SIZE 8
 SECURITY_READ_ONLY_LATE(static ptov_table_entry)        ptov_table[PTOV_TABLE_SIZE];
+
+/*
+ * g0245d v221: after arm_vm_init() swaps TTBR0 to the invalid table the kernel
+ * no longer runs on the bootstrap V=P mapping, so BootArgs->Video.v_baseAddr
+ * (a raw physical address) stops being a valid VA. Writing a checkpoint there
+ * faults, and the probe itself would kill the boot. Expose a non-panicking
+ * physical -> virtual translation plus a flag that says when it is needed.
+ */
+boolean_t g0245d_kva_live = FALSE;
+
+vm_offset_t
+g0245d_fb_kva(vm_offset_t pa)
+{
+	size_t i;
+
+	for (i = 0; (i < PTOV_TABLE_SIZE) && (ptov_table[i].len != 0); i++) {
+		if ((pa >= ptov_table[i].pa) &&
+		    (pa < (ptov_table[i].pa + ptov_table[i].len))) {
+			return (vm_offset_t)(pa - ptov_table[i].pa + ptov_table[i].va);
+		}
+	}
+	if ((pa >= gPhysBase) && ((pa - gPhysBase) < real_phys_size)) {
+		return (vm_offset_t)(pa - gPhysBase + gVirtBase);
+	}
+	return 0;
+}
 SECURITY_READ_ONLY_LATE(static boolean_t)               kva_active = FALSE;
 
 
