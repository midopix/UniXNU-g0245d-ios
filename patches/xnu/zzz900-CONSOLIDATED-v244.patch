+/*
+ * g0245d v210: post-return C-side boot marks.
+ *
+ * v209 stops at the last band painted just before start.s returns. The bands
+ * below are painted from inside arm_init, so one can only appear if control
+ * really landed in C instead of dying somewhere after that `ret`.
+ *
+ * Every mark here sits before arm_vm_init(). Until it runs, TTBR0 still holds
+ * the bootstrap V=P table whose 0x83400000 window v209 added, so a store by
+ * physical address stays valid. arm_vm_init installs the kernel pmap, after
+ * which the same store is undefined -- hence nothing is painted past it.
+ *
+ * ARM_TTE_BOOT_BLOCK maps that window write-back cacheable, so the band has to
+ * be cleaned to the point of coherency; the panel reads DRAM, and a dirty line
+ * would leave the band invisible.
+ *
+ * Byte order is (G, R, B) and the panel shows raw row R at 1919 - R, exactly
+ * like FB_MARK207 in start.s.
+ */
+#define G0245D_FB_BAND_ROWS     8
+#define G0245D_FB_BAND_WIDTH    1080
+
+extern boolean_t g0245d_kva_live;
+extern vm_offset_t g0245d_fb_kva(vm_offset_t pa);
+
+/* g0245d v228: set once the text console owns rows 0..G0245D_CON_TOP. */
+unsigned int g0245d_con_owns_text;
+
+static void __attribute__((noinline))
+g0245d_fb_band(
+	boot_args       *args,
+	unsigned int    row,
+	unsigned char   g,
+	unsigned char   r,
+	unsigned char   b)
+{
+	uintptr_t       fb = (uintptr_t)args->Video.v_baseAddr;
+	unsigned long   rowbytes = args->Video.v_rowBytes;
+	uintptr_t       start;
+	uintptr_t       end;
+	uintptr_t       p;
+	unsigned int    y;
+	unsigned int    x;
+
+	if (fb == 0 || rowbytes == 0) {
+		return;
+	}
+
+	/* g0245d v228: the console owns rows 0..G0245D_CON_TOP.  A band
+	 * drawn there after the console is up would erase up to eight rows
+	 * of text that is now the better evidence.  The ladder survives
+	 * below G0245D_CON_TOP and in every pre-console phase.
+	 */
+	if (g0245d_con_owns_text && row < 1140) {
+		return;
+	}
+
+	/* g0245d v221: past the TTBR switch the raw physical value is no longer a
+	 * valid VA; translate it through the physmap instead of faulting. */
+	if (g0245d_kva_live) {
+		fb = (uintptr_t)g0245d_fb_kva((vm_offset_t)fb);
+		if (fb == 0) {
+			return;
+		}
+	}
+
+	start = fb + (uintptr_t)row * (uintptr_t)rowbytes;
+	end = start + (uintptr_t)G0245D_FB_BAND_ROWS * (uintptr_t)rowbytes;
+
+	for (y = 0; y < G0245D_FB_BAND_ROWS; y++) {
+		p = start + (uintptr_t)y * (uintptr_t)rowbytes;
+		for (x = 0; x < G0245D_FB_BAND_WIDTH; x++) {
+			*(volatile unsigned char *)(p + 0) = g;
+			*(volatile unsigned char *)(p + 1) = r;
+			*(volatile unsigned char *)(p + 2) = b;
+			p += 3;
+		}
+	}
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (p = start; p < end; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * g0245d v215: wipe the whole framebuffer before painting this boot's marks.
+ *
+ * The DarwinBoot menu, the Apple logo, the version banner and the boot
+ * progress bar all occupy the same rows as our checkpoints, and once the
+ * camera has smeared them they are indistinguishable from a dim band. Clear
+ * first, and every colour left on the panel then comes from a
+ * g0245d_fb_band() call made by this boot -- the photo becomes a plain
+ * ordered ladder of lines on black.
+ *
+ * start.s only identity-maps the first 8 MiB above the framebuffer in the
+ * bootstrap V=P table (four 2 MiB blocks at 0x83400000), so the wipe is
+ * clamped to that window instead of trusting v_height.
+ */
+#define G0245D_FB_WINDOW_BYTES	(8ULL * 1024ULL * 1024ULL)
+#define G0245D_FB_WIPE_MAX_ROWS	1920ULL	/* panel is exactly 1920 lines */
+
+static void __attribute__((noinline))
+g0245d_fb_wipe(
+	boot_args       *args)
+{
+	uintptr_t       fb = (uintptr_t)args->Video.v_baseAddr;
+	unsigned long   rowbytes = args->Video.v_rowBytes;
+	unsigned long   rows;
+	unsigned long   y;
+	uintptr_t       p;
+	uintptr_t       e;
+
+	if (fb == 0 || rowbytes == 0) {
+		return;
+	}
+	if ((uint64_t)rowbytes > G0245D_FB_WINDOW_BYTES) {
+		return;
+	}
+
+	rows = (unsigned long)(G0245D_FB_WINDOW_BYTES / (uint64_t)rowbytes);
+	if (rows > G0245D_FB_WIPE_MAX_ROWS) {
+		rows = (unsigned long)G0245D_FB_WIPE_MAX_ROWS;
+	}
+
+	for (y = 0; y < rows; y++) {
+		p = fb + (uintptr_t)y * (uintptr_t)rowbytes;
+		e = p + (uintptr_t)rowbytes;
+		if (((p | (uintptr_t)rowbytes) & 7) == 0) {
+			for (; p < e; p += 8) {
+				*(volatile uint64_t *)p = 0;
+			}
+		} else {
+			for (; p < e; p++) {
+				*(volatile unsigned char *)p = 0;
+			}
+		}
+	}
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	p = fb;
+	e = fb + (uintptr_t)rows * (uintptr_t)rowbytes;
+	for (; p < e; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ===== g0245d v226 console BEGIN ===== */
+/*
+ * Text console on the boot framebuffer.
+ *
+ * serial_init() returns 0 on this board before registering any driver, and
+ * PE_init_printf() is never reached, so up to now the kernel has had no way
+ * to say anything. We therefore draw with iso_font directly into the frame
+ * buffer that firmware handed over in args->Video.
+ *
+ * The console owns framebuffer rows 0..G0245D_CON_TOP; the colour-band
+ * ladder keeps the rows above 1140. Text grows upward from row 0 (the row
+ * that appears at the bottom of the panel), so the newest line is the
+ * lowest one.
+ */
+extern unsigned char iso_font[256 * 16];
+#include <stdarg.h>
+
+#define G0245D_CON_SCALE   2
+#define G0245D_CON_CW      (8 * G0245D_CON_SCALE)
+#define G0245D_CON_CH      (16 * G0245D_CON_SCALE)
+#define G0245D_CON_TOP     1140
+
+/* g0245d v231: the scan-out window is rotated by this many pixels
+ * inside each framebuffer row.  The v230 photo showed a run written
+ * at console column 0 landing at screen x 780 of 1080, wrapping at
+ * the right edge back to the left edge, so the rotation is
+ * 1080 - 780 = 300 px.  Every mirrored x has to be moved by it.
+ */
+#define G0245D_CON_XOFF    300
+
+static volatile unsigned char *g0245d_con_base;
+static unsigned long g0245d_con_stride;
+static unsigned int  g0245d_con_bpp;
+static unsigned int  g0245d_con_cols;
+static unsigned int  g0245d_con_rows;
+static unsigned int  g0245d_con_nscroll;  /* g0245d v230: rows - 1 */
+static unsigned int  g0245d_con_col;
+static unsigned int  g0245d_con_row;
+static unsigned int  g0245d_con_ready;
+static unsigned int  g0245d_con_seq;
+static unsigned int  g0245d_con_w;      /* g0245d v227: panel width  */
+static unsigned int  g0245d_con_h;      /* g0245d v227: panel height */
+
+static void
+g0245d_con_px(unsigned int x, unsigned int y, unsigned int on)
+{
+	int fx;
+	volatile unsigned char *p;
+	unsigned char v;
+	/* g0245d v227: the panel scans the frame buffer rotated by 180
+	 * degrees (fb row 0 lands at the bottom of the panel and x grows to
+	 * the left), so every pixel must be written mirrored on both axes or
+	 * the text comes out upside down.
+	 */
+	/* g0245d v231: mirror for the 180-degree scan, then rotate by
+	 * G0245D_CON_XOFF so that console column 0 really lands on the
+	 * panel's left edge and the line stops wrapping mid-word.
+	 */
+	fx = (int)(g0245d_con_w - 1 - x) - G0245D_CON_XOFF;
+	if (fx < 0) {
+		fx += (int)g0245d_con_w;
+	}
+	p = g0245d_con_base
+	    + (unsigned long)(g0245d_con_h - 1 - y) * g0245d_con_stride
+	    + (unsigned long)fx * g0245d_con_bpp;
+	v = on ? 0xFF : 0x00;
+
+	p[0] = v;
+	p[1] = v;
+	p[2] = v;
+	if (g0245d_con_bpp > 3) {
+		p[3] = 0xFF;
+	}
+}
+
+static void
+g0245d_con_fill_row(unsigned int row)
+{
+	unsigned int x, y;
+
+	for (y = 0; y < G0245D_CON_CH; y++) {
+		for (x = 0; x < g0245d_con_cols * G0245D_CON_CW; x++) {
+			g0245d_con_px(x, row * G0245D_CON_CH + y, 0);
+		}
+	}
+}
+
+static void
+g0245d_con_sync(void)
+{
+	unsigned long p, end;
+
+	if (!g0245d_con_ready) {
+		return;
+	}
+	/* g0245d v230: the status row sits below the scroll cursor, so flush
+	 * every text row instead of only the ones above the cursor. */
+	end = (unsigned long)g0245d_con_base
+	    + (unsigned long)g0245d_con_rows * G0245D_CON_CH * g0245d_con_stride;
+	for (p = (unsigned long)g0245d_con_base; p < end; p += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* args->Video is filled in by the firmware; no ADT interpretation involved. */
+static void
+g0245d_con_init(boot_args *args)
+{
+	unsigned long base = args->Video.v_baseAddr;
+	unsigned long stride = args->Video.v_rowBytes;
+	unsigned long width = args->Video.v_width;
+	unsigned long height = args->Video.v_height;
+	unsigned int r;
+
+	g0245d_con_ready = 0;
+	if (base == 0 || stride == 0 || width == 0 || height == 0) {
+		return;
+	}
+	if (width > 4096 || stride > 16384 || height > 4096) {
+		return;
+	}
+	g0245d_con_base = (volatile unsigned char *)base;
+	g0245d_con_stride = stride;
+	g0245d_con_w = (unsigned int)width;
+	g0245d_con_h = (unsigned int)height;
+	g0245d_con_bpp = (stride >= width * 4) ? 4 : 3;
+	g0245d_con_cols = (unsigned int)(width / G0245D_CON_CW);
+	g0245d_con_rows = G0245D_CON_TOP / G0245D_CON_CH;
+	/* g0245d v230: keep the last row out of the scroll ring so it can
+	 * hold a status line that never scrolls away. */
+	/* g0245d v231: row rows-2 is the column ruler and row rows-1 the
+	 * status line; neither is in the ring, so both stay put. */
+	/* g0245d v233: row rows-3 is the probe line -- one live label that
+	 * the device-tree walk overwrites per node, so it survives every
+	 * ring wrap and always names the last node converted. */
+	g0245d_con_nscroll = (g0245d_con_rows > 3) ?
+	    g0245d_con_rows - 3 : g0245d_con_rows;
+	g0245d_con_col = 0;
+	g0245d_con_row = 0;
+	if (g0245d_con_cols == 0 || g0245d_con_rows == 0) {
+		return;
+	}
+	g0245d_con_ready = 1;
+	g0245d_con_owns_text = 1;
+	for (r = 0; r < g0245d_con_rows; r++) {
+		g0245d_con_fill_row(r);
+	}
+	g0245d_con_sync();
+}
+
+void
+g0245d_con_putc(char c)
+{
+	const unsigned char *glyph;
+	unsigned int gx, gy, sx, sy, x0, y0;
+
+	if (!g0245d_con_ready) {
+		return;
+	}
+	if (c == '\r') {
+		g0245d_con_col = 0;
+		return;
+	}
+	if (c == '\n' || g0245d_con_col >= g0245d_con_cols) {
+		unsigned int wrap_row;
+		g0245d_con_col = 0;
+		g0245d_con_row = (g0245d_con_row + 1) % g0245d_con_nscroll;
+		/* g0245d v233: the ring is shown linearly, so once the cursor
+		 * wraps the panel holds newest text on top and stale text
+		 * below, which reads as scrambled output.  Blank the whole
+		 * ring on wrap instead: the panel then always reads
+		 * newest-at-top with nothing old mixed in.
+		 */
+		if (g0245d_con_row == 0) {
+			for (wrap_row = 1; wrap_row < g0245d_con_nscroll;
+			    wrap_row++) {
+				g0245d_con_fill_row(wrap_row);
+			}
+		}
+		g0245d_con_fill_row(g0245d_con_row);
+		if (c == '\n') {
+			/* g0245d v227: flush every completed line.  In v226 only
+			 * every 8th printf was flushed, so a hang could leave up
+			 * to three finished lines sitting in the cache and the
+			 * last visible checkpoint was up to three steps stale.
+			 */
+			g0245d_con_sync();
+			return;
+		}
+	}
+	glyph = iso_font + ((unsigned char)c) * 16;
+	x0 = g0245d_con_col * G0245D_CON_CW;
+	y0 = g0245d_con_row * G0245D_CON_CH;
+	for (gy = 0; gy < 16; gy++) {
+		for (gx = 0; gx < 8; gx++) {
+			if ((glyph[gy] & (1u << gx)) == 0) {
+				continue;
+			}
+			for (sy = 0; sy < G0245D_CON_SCALE; sy++) {
+				for (sx = 0; sx < G0245D_CON_SCALE; sx++) {
+					g0245d_con_px(x0 + gx * G0245D_CON_SCALE + sx,
+					    y0 + gy * G0245D_CON_SCALE + sy, 1);
+				}
+			}
+		}
+	}
+	g0245d_con_col++;
+}
+
+static void
+g0245d_con_puts(const char *s)
+{
+	while (*s) {
+		g0245d_con_putc(*s++);
+	}
+}
+
+
+/* g0245d v230: one fixed line at the bottom of the text area.  Ordinary
+ * traces scroll through rows 0..rows-2; this row is never part of the ring,
+ * so the last phase to call it stays on screen no matter how much output
+ * follows.  Pass a short label; it is clipped to the panel width.
+ */
+void
+g0245d_status(const char *label)
+{
+	unsigned int    row = g0245d_con_row;
+	unsigned int    col = g0245d_con_col;
+	unsigned int    i;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 2 || label == 0) {
+		return;
+	}
+	g0245d_con_row = g0245d_con_rows - 1;
+	g0245d_con_col = 0;
+	g0245d_con_fill_row(g0245d_con_row);
+	g0245d_con_putc('>');
+	for (i = 1; i + 1 < g0245d_con_cols && label[i - 1]; i++) {
+		g0245d_con_putc(label[i - 1]);
+	}
+	g0245d_con_row = row;
+	g0245d_con_col = col;
+	g0245d_con_sync();
+}
+
+
+/* g0245d v231: one permanent row of unique characters -- 'A'..'Z',
+ * 'a'..'z', '0'..'9', then "!@#$%^&".  Any character read off a photo then
+ * names its own console column, so the x-rotation above can be calibrated
+ * from a single picture instead of guessed twice.
+ */
+static void
+g0245d_con_ruler(void)
+{
+	static const char ruler[] =
+	    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&";
+	unsigned int    row;
+	unsigned int    i;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 3) {
+		return;
+	}
+	row = g0245d_con_rows - 2;
+	g0245d_con_fill_row(row);
+	for (i = 0; i < g0245d_con_cols && ruler[i] != '\0'; i++) {
+		g0245d_con_row = row;
+		g0245d_con_col = i;
+		g0245d_con_putc(ruler[i]);
+	}
+	g0245d_con_row = 0;
+	g0245d_con_col = 0;
+	g0245d_con_sync();
+}
+
+static void
+g0245d_con_putu(unsigned long v, unsigned int base, unsigned int pad)
+{
+	char tmp[24];
+	unsigned int n = 0;
+
+	do {
+		unsigned int d = (unsigned int)(v % base);
+		tmp[n++] = (char)(d < 10 ? '0' + d : 'a' + d - 10);
+		v /= base;
+	} while (v && n < sizeof(tmp));
+	while (n < pad) {
+		tmp[n++] = '0';
+	}
+	while (n) {
+		g0245d_con_putc(tmp[--n]);
+	}
+}
+
+/* Tiny formatter: %s %c %d %u %x %p %% only. No locale, no locks. */
+void
+g0245d_con_printf(const char *fmt, ...)
+{
+	va_list ap;
+	const char *s;
+
+	if (!g0245d_con_ready) {
+		if (g0245d_con_base == 0) {
+			return;
+		}
+		/* g0245d v237: take the console back instead of going silent. */
+		g0245d_con_ready = 1;
+		g0245d_con_owns_text = 1;
+	}
+	if (!g0245d_con_ready) {
+		return;
+	}
+	va_start(ap, fmt);
+	while (*fmt) {
+		if (*fmt != '%') {
+			g0245d_con_putc(*fmt++);
+			continue;
+		}
+		fmt++;
+		switch (*fmt) {
+		case 's':
+			s = va_arg(ap, const char *);
+			g0245d_con_puts(s ? s : "(null)");
+			break;
+		case 'c':
+			g0245d_con_putc((char)va_arg(ap, int));
+			break;
+		case 'd':
+			g0245d_con_putu((unsigned long)va_arg(ap, int), 10, 0);
+			break;
+		case 'u':
+			g0245d_con_putu(va_arg(ap, unsigned int), 10, 0);
+			break;
+		case 'x':
+			g0245d_con_putu(va_arg(ap, unsigned int), 16, 0);
+			break;
+		case 'p':
+			g0245d_con_puts("0x");
+			g0245d_con_putu((unsigned long)va_arg(ap, void *), 16, 0);
+			break;
+		case '%':
+			g0245d_con_putc('%');
+			break;
+		case '\0':
+			fmt--;
+			break;
+		default:
+			g0245d_con_putc('%');
+			g0245d_con_putc(*fmt);
+			break;
+		}
+		fmt++;
+	}
+	va_end(ap);
+	if (g0245d_con_seq++ % 8 == 7) {
+		g0245d_con_sync();
+	}
+}
+
+/*
+ * A checkpoint: one text line, then the same colour band as before so the
+ * old ladder keeps working as a fallback if the font path ever misbehaves.
+ */
+static void
+g0245d_mark(boot_args *args, unsigned int row, unsigned char g, unsigned char r,
+    unsigned char b, const char *label)
+{
+	g0245d_con_printf("%u row=%u %s\n", g0245d_con_seq, row, label);
+	g0245d_fb_band(args, row, g, r, b);
+	g0245d_con_sync();
+}
+/* g0245d v229: same idea as g0245d_mark(), without the band.  Reachable
+ * from any subsystem that repeats the two extern declarations above, and
+ * safe to call before the console exists (g0245d_con_printf swallows it).
+ */
+/* g0245d v233 con probe: one pinned line directly above the ruler.
+ * The device-tree walk calls this once per node, so the panel names
+ * the node that was being converted when the machine stopped -- even
+ * after the ring has wrapped a dozen times.  Cheap enough to call
+ * per node: one row fill, at most cols-6 glyphs, one cache clean.
+ */
+static unsigned int g0245d_probe_seq;
+
+void
+g0245d_probe(const char *label)
+{
+	unsigned int   row;
+	unsigned int   col;
+	unsigned int   i;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 4 || label == 0) {
+		return;
+	}
+	row = g0245d_con_row;
+	col = g0245d_con_col;
+	g0245d_con_row = g0245d_con_rows - 3;
+	g0245d_con_col = 0;
+	g0245d_con_fill_row(g0245d_con_row);
+	g0245d_con_putu((unsigned long)++g0245d_probe_seq, 10, 0);
+	g0245d_con_putc(' ');
+	for (i = 0; label[i] != '\0' && i + 5 < g0245d_con_cols; i++) {
+		g0245d_con_putc(label[i]);
+	}
+	g0245d_con_row = row;
+	g0245d_con_col = col;
+	g0245d_con_sync();
+}
+
+/* g0245d v236: the trace sequence, so the pinned row can say at which
+ * point in the log it was drawn -- that is what separates "console frozen"
+ * from "screen left over from an earlier boot".
+ */
+static unsigned int g0245d_trace_seq;
+
+/* g0245d v234: the same pinned row, for a raw address.  Printed as
+ * <index> 0x<16 hex digits> so a photo of the panel can be matched
+ * against the kernel's __mod_init_func table without symbols.
+ */
+void
+g0245d_probe_pc(uintptr_t pc, unsigned int idx)
+{
+	unsigned int   row;
+	unsigned int   col;
+	unsigned int   i;
+	unsigned int   d;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 4) {
+		return;
+	}
+	row = g0245d_con_row;
+	col = g0245d_con_col;
+	g0245d_con_row = g0245d_con_rows - 3;
+	g0245d_con_col = 0;
+	g0245d_con_fill_row(g0245d_con_row);
+	g0245d_con_putu((unsigned long)idx, 10, 0);
+	g0245d_con_putc('/');
+	g0245d_con_putu(98, 10, 0);
+	g0245d_con_putc(' ');
+	g0245d_con_putc('s');
+	/* g0245d v236: the log line number this probe belongs to. */
+	g0245d_con_putu((unsigned long)g0245d_trace_seq, 10, 0);
+	g0245d_con_putc(' ');
+	g0245d_con_putu((unsigned long)(pc >> 48), 16, 0);
+	for (i = 0; i < 12; i++) {
+		d = (unsigned int)((pc >> (44 - 4 * i)) & 0xf);
+		g0245d_con_putc((char)(d < 10 ? '0' + d : 'a' + d - 10));
+	}
+	g0245d_con_row = row;
+	g0245d_con_col = col;
+	g0245d_con_sync();
+}
+
+/* g0245d v237: a second pinned row, for "which class is postModLoad on".
+ * The constructor probe owns rows-3; this one owns rows-4, so a single photo
+ * shows both at once.  It writes straight to the panel like probe_pc(), i.e.
+ * it does not depend on the ring or on the %u path of con_printf().
+ */
+void
+g0245d_probe_u(const char *tag, unsigned int value)
+{
+	unsigned int row;
+	unsigned int col;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 5) {
+		return;
+	}
+	row = g0245d_con_row;
+	col = g0245d_con_col;
+	g0245d_con_row = g0245d_con_rows - 4;
+	g0245d_con_col = 0;
+	g0245d_con_fill_row(g0245d_con_row);
+	if (tag) {
+		g0245d_con_puts(tag);
+		g0245d_con_putc(' ');
+	}
+	g0245d_con_putu((unsigned long)value, 10, 0);
+	g0245d_con_row = row;
+	g0245d_con_col = col;
+	g0245d_con_sync();
+}
+
+/* g0245d v238: the same pinned row, for "which class, how deep".
+ * stage: 0 = loop top, 1 = after the duplicate lookup, 2 = inside the
+ * superclass walk, 3 = walk finished, 4 = the link is not a kernel pointer.
+ * The name is copied byte by byte with a fixed limit: className is still a
+ * plain C string at this point, and a bring-up image is no place to trust
+ * strlen() on whatever the link field happens to point at.
+ */
+/* g0245d v242: <index> <low 32 bits of a function pointer> on the pinned
+ * row.  The ring line that names a startup routine is 38 characters and is
+ * exactly the line that turns to fuzz when the machine dies mid-flush; the
+ * pinned row is redrawn whole every time and has stayed legible in every
+ * photo so far.
+ */
+void
+g0245d_probe_fn(unsigned int idx, unsigned long long fn)
+{
+	unsigned int row;
+	unsigned int col;
+	unsigned int i;
+	unsigned int d;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 5) {
+		return;
+	}
+	row = g0245d_con_row;
+	col = g0245d_con_col;
+	g0245d_con_row = g0245d_con_rows - 4;
+	g0245d_con_col = 0;
+	g0245d_con_fill_row(g0245d_con_row);
+	g0245d_con_puts("su ");
+	g0245d_con_putu((unsigned long)idx, 10, 0);
+	g0245d_con_putc(' ');
+	for (i = 0; i < 8; i++) {
+		d = (unsigned int)((fn >> (28 - 4 * (int)i)) & 0xf);
+		g0245d_con_putc((char)(d < 10 ? '0' + d : 'a' + d - 10));
+	}
+	g0245d_con_row = row;
+	g0245d_con_col = col;
+	g0245d_con_sync();
+}
+
+void
+g0245d_probe_cls(unsigned int idx, unsigned int total, unsigned int stage,
+    unsigned int depth, uintptr_t ptr, const char *name)
+{
+	static const char stage_char[5] = { 'a', 'b', 'w', 'c', '!' };
+	unsigned int      row;
+	unsigned int      col;
+	unsigned int      i;
+	unsigned int      d;
+
+	if (!g0245d_con_ready || g0245d_con_rows < 5) {
+		return;
+	}
+	row = g0245d_con_row;
+	col = g0245d_con_col;
+	g0245d_con_row = g0245d_con_rows - 4;
+	g0245d_con_col = 0;
+	g0245d_con_fill_row(g0245d_con_row);
+	g0245d_con_putu((unsigned long)idx, 10, 0);
+	g0245d_con_putc('/');
+	g0245d_con_putu((unsigned long)total, 10, 0);
+	g0245d_con_putc(' ');
+	g0245d_con_putc(stage_char[stage < 5 ? stage : 4]);
+	g0245d_con_putu((unsigned long)depth, 10, 0);
+	g0245d_con_putc(' ');
+	/* g0245d v239: low 32 bits of the pointer, 8 hex digits.  Every meta
+	 * class object in this kernel sits at 0xfffffff007xxxxxx, so the low
+	 * half is enough to name one, and 8 digits keep the row readable.
+	 */
+	for (i = 0; i < 8; i++) {
+		d = (unsigned int)((ptr >> (28 - 4 * (int)i)) & 0xf);
+		g0245d_con_putc((char)(d < 10 ? '0' + d : 'a' + d - 10));
+	}
+	g0245d_con_putc(' ');
+	for (i = 0; i < 18 && name != 0 && name[i] != '\0'; i++) {
+		g0245d_con_putc(name[i]);
+	}
+	g0245d_con_row = row;
+	g0245d_con_col = col;
+	g0245d_con_sync();
+}
+
+void
+g0245d_trace(const char *label)
+{
+	/* g0245d v236: if something cleared the console's ready flag while
+	 * the framebuffer is still valid, take it back instead of going
+	 * silent.  Silence here would look exactly like a hang.
+	 */
+	if (!g0245d_con_ready && g0245d_con_base != 0) {
+		g0245d_con_ready = 1;
+		g0245d_con_owns_text = 1;
+		g0245d_con_printf("%u v236 console rearmed\n",
+		    ++g0245d_trace_seq);
+		g0245d_con_sync();
+	}
+	g0245d_con_printf("%u %s\n", ++g0245d_trace_seq, label);
+	g0245d_con_sync();
+}
+
+/* g0245d v236: label + one index, used to log walk progress. */
+void
+g0245d_trace_u(const char *label, unsigned int value)
+{
+	g0245d_con_printf("%u %s %u\n", ++g0245d_trace_seq, label, value);
+	g0245d_con_sync();
+}
+
+void
+g0245d_tracev(const char *label, unsigned long long value)
+{
+	g0245d_con_printf("%u %s %p\n", ++g0245d_trace_seq, label,
+	    (void *)(uintptr_t)value);
+	g0245d_con_sync();
+}
+
+/* g0245d v235: trace that carries a Mach-O segment name.  segname is
+ * char[16] and is not guaranteed to be NUL-terminated, so copy first.
+ */
+void
+g0245d_trace_seg(const char *label, const char *segname)
+{
+	char           buf[17];
+	unsigned int   i;
+
+	if (!g0245d_con_ready) {
+		return;
+	}
+	for (i = 0; i < 16 && segname != 0 && segname[i] != '\0'; i++) {
+		buf[i] = segname[i];
+	}
+	buf[i] = '\0';
+	g0245d_con_printf("%u %s %s\n", ++g0245d_trace_seq, label, buf);
+	g0245d_con_sync();
+}
