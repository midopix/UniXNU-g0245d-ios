+void g0245d_wfe_mark(unsigned int row, unsigned char g, unsigned char r, unsigned char b, uint64_t value);
+
+void __attribute__((noinline))
+g0245d_wfe_mark(unsigned int row, unsigned char g, unsigned char r, unsigned char b, uint64_t value)
+{
+	__asm__ volatile ("" :: "r"(value) : "memory");
+	g0245d_con_printf("%u wfe row=%u val=%p\n",
+	    g0245d_con_seq, row, (void *)(uintptr_t)value);
+	g0245d_fb_band(BootArgs, row, g, r, b);
+}
+
+/* g0245d v225: band probe usable from pexpert/, where boot_args is not in
