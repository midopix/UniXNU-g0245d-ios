+# G0345D v137 documented the same failure on the same chip; disable it here.
+# CONFIG_XNU_NATIVE_PAN is not set
 # Secondary CPU bring-up: enable after the GIC 3-cell specifier check passes.
 # CONFIG_XNU_ARMCPU_SECONDARY is not set
 # CONFIG_XNU_BUILD_ARCHIVES is not set    (enable with the first native driver)
