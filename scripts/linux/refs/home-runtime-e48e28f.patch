+def check_volume(image):
+    """Refuse a BPB whose declared FAT type disagrees with its cluster count.
+
+    EDK2 (FatPkg) chooses the type from the cluster count, not from the BPB
+    strings, so a volume written as FAT32 with fewer than 65525 clusters is
+    read as FAT16 with a zero FAT size and fails to mount.
+    """
+    raw = Path(image).read_bytes()
+    if len(raw) < 512 or raw[510:512] != b'\x55\xaa':
+        raise Error(f'payload volume {image} has no 0x55aa boot signature')
+    bps, = struct.unpack_from('<H', raw, 0x0b)
+    spc = raw[0x0d]
+    reserved, = struct.unpack_from('<H', raw, 0x0e)
+    fats = raw[0x10]
+    root_entries, = struct.unpack_from('<H', raw, 0x11)
+    total16, = struct.unpack_from('<H', raw, 0x13)
+    fat16, = struct.unpack_from('<H', raw, 0x16)
+    total32, = struct.unpack_from('<I', raw, 0x20)
+    fat32, = struct.unpack_from('<I', raw, 0x24)
+    if bps == 0 or spc == 0 or fats == 0:
+        raise Error(f'payload volume {image} has an empty BPB')
+    total = total16 or total32
+    root_sectors = (root_entries * 32 + bps - 1) // bps
+    if fat16 and total16:
+        data = total - reserved - fats * fat16 - root_sectors
+        clusters = data // spc
+        fat_size = fat16
+        width = 2
+        kind = 12 if clusters < 4085 else 16
+    else:
+        data = total - reserved - fats * fat32
+        clusters = data // spc
+        fat_size = fat32
+        width = 4
+        kind = 32
+    entries = fat_size * bps // width
+    if kind == 32 and clusters < 65525:
+        raise Error(f'payload volume {image} claims FAT32 but has only {clusters} clusters')
+    if kind != 32 and clusters >= 65525:
+        raise Error(f'payload volume {image} claims FAT{kind} but has {clusters} clusters')
+    if entries < clusters + 2:
+        raise Error(f'payload volume {image} FAT{kind} holds {entries} entries for {clusters} clusters')
+    log(f'payload: volume FAT{kind}, {clusters} clusters, {entries} FAT entries')
+
+
